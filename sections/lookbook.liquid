{{ 'section-lookbook.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign look_collection = section.settings.products_collection
  assign main_image = section.settings.main_image
  assign modal_image = section.settings.modal_image
-%}

<div class="lookbook section" {{ section.shopify_attributes }}>
  <div class="lookbook_main_container">
    <div class="lookbook__grid color-{{ section.settings.color_scheme }}">
      <div class="lookbook__media">
        {%- if main_image != blank -%}
          <img
            class="lookbook__media-img motion-reduce"
            srcset="
              {%- if main_image.width >= 375 -%}{{ main_image | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if main_image.width >= 750 -%}{{ main_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if main_image.width >= 1100 -%}{{ main_image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {{ main_image | image_url }} {{ main_image.width }}w
            "
            src="{{ main_image | image_url: width: 1100 }}"
            width="{{ main_image.width }}"
            height="{{ main_image.height }}"
            alt="{{ main_image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="lookbook__media-placeholder">
            {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="lookbook__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="lookbook__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="lookbook__text rte">
          {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="lookbook__cta-bar">
    <div class="lookbook_main">
      <modal-opener data-modal="#LookbookModal-{{ section.id }}">
        <button type="button" class="lookbook__cta-button">
          {{ section.settings.button_label | escape }}
        </button>
      </modal-opener>
    </div>
  </div>

  <modal-dialog id="LookbookModal-{{ section.id }}" class="lookbook-modal">
    <div class="lookbook-modal__content" role="dialog" aria-modal="true" aria-label="{{ section.settings.modal_heading | escape }}" tabindex="-1">
      <button
        id="ModalClose-{{ section.id }}"
        type="button"
        class="lookbook-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>

      <div class="lookbook-modal__inner">
        <div class="lookbook-modal__products">

          {%- if look_collection != blank and look_collection.products_count > 0 -%}
            <div class="lookbook-modal__product-list">
              {%- for product in look_collection.products limit: 3 -%}
                {%- assign product_image = product.featured_image -%}
                {%- assign form_id = 'lookbook-form-' | append: section.id | append: '-' | append: product.id -%}
                {%- assign selected_variant = product.selected_or_first_available_variant -%}
                {%- if selected_variant == blank and product.variants.size > 0 -%}
                  {%- assign selected_variant = product.variants.first -%}
                {%- endif -%}
                <div class="lookbook-modal__product">
                  <a class="lookbook-modal__product-media" href="{{ product.url }}">
                    {%- if product_image != blank -%}
                      <img
                        srcset="
                          {%- if product_image.width >= 160 -%}{{ product_image | image_url: width: 160 }} 160w,{%- endif -%}
                          {%- if product_image.width >= 320 -%}{{ product_image | image_url: width: 320 }} 320w,{%- endif -%}
                          {{ product_image | image_url }} {{ product_image.width }}w
                        "
                        src="{{ product_image | image_url: width: 320 }}"
                        width="{{ product_image.width }}"
                        height="{{ product_image.height }}"
                        loading="lazy"
                        alt="{{ product_image.alt | escape }}"
                      >
                    {%- else -%}
                      <div class="lookbook-modal__product-media-placeholder">
                        {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </a>

                  <div class="lookbook-modal__product-info">
                    <div class="lookbook-modal__product-heading">
                      <a class="lookbook-modal__product-title-link" href="{{ product.url }}">
                        <div class="lookbook-modal__product-title">{{ product.title | escape }}</div>
                      </a>
                      <div class="lookbook-modal__product-price">
                        {% render 'lookbook-product-price', variant: selected_variant %}
                      </div>
                    </div>

                    {%- if product.description != blank -%}
                      <div class="lookbook-modal__product-description">
                        {{ product.description | strip_html | truncatewords: 8 }}
                      </div>
                    {%- endif -%}

                    {%- form 'product', product, id: form_id, class: 'form lookbook-modal__ajax-form', novalidate: 'novalidate' -%}
                      <div class="lookbook-modal__form-message" role="alert" hidden></div>
                      <input type="hidden" name="quantity" value="1">

                      <div class="lookbook-modal__controls">
                        <div class="lookbook-modal__controls-select">
                          {%- unless product.has_only_default_variant -%}
                            <select
                              id="LookbookVariant-{{ section.id }}-{{ product.id }}"
                              class="lookbook-modal__variant-select"
                              name="id"
                            >
                              {%- for variant in product.variants -%}
                                <option
                                  value="{{ variant.id }}"
                                  {% if variant == selected_variant %}
                                    selected
                                  {% endif %}
                                  {% unless variant.available %}
                                    disabled
                                  {% endunless %}
                                >
                                  {{ variant.title | escape }}{% unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
                                </option>
                              {%- endfor -%}
                            </select>
                          {%- else -%}
                            <input type="hidden" name="id" value="{{ selected_variant.id }}">
                          {%- endunless -%}
                        </div>

                        <div class="lookbook-modal__controls-button">
                          <button
                            id="LookbookSubmitButton-{{ section.id }}-{{ product.id }}"
                            type="submit"
                            name="add"
                            class="lookbook-modal__add-button button button--secondary"
                            {% if selected_variant.available == false %}
                              disabled
                            {% endif %}
                          >
                            <span>{{ 'products.product.add_to_cart' | t }}</span>
                            {%- render 'loading-spinner' -%}
                          </button>
                        </div>
                      </div>
                      {%- endform -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <p class="lookbook-modal__empty">Немає товарів у вибраній колекції.</p>
          {%- endif -%}
        </div>

        <div class="lookbook-modal__image">
          {%- if modal_image != blank -%}
            <img
              class="lookbook-modal__image-img motion-reduce"
              srcset="
                {%- if modal_image.width >= 600 -%}{{ modal_image | image_url: width: 600 }} 600w,{%- endif -%}
                {%- if modal_image.width >= 900 -%}{{ modal_image | image_url: width: 900 }} 900w,{%- endif -%}
                {{ modal_image | image_url }} {{ modal_image.width }}w
              "
              src="{{ modal_image | image_url: width: 900 }}"
              width="{{ modal_image.width }}"
              height="{{ modal_image.height }}"
              loading="lazy"
              alt="{{ modal_image.alt | escape }}"
            >
          {%- else -%}
            <div class="lookbook-modal__image-placeholder">
              {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </modal-dialog>
</div>

<script>
  (() => {
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionRoot) return;

    const updateCartCount = (count) => {
      document.querySelectorAll('.cart-count-bubble').forEach((bubble) => {
        if (count > 0) {
          bubble.style.display = 'flex';
        } else {
          bubble.style.display = 'none';
        }

        const countNode = bubble.querySelector('span[aria-hidden="true"]');
        if (countNode) countNode.textContent = count;
      });
    };

    sectionRoot.querySelectorAll('.lookbook-modal__ajax-form').forEach((form) => {
      if (form.dataset.ajaxBound === 'true') return;
      form.dataset.ajaxBound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        const spinner = form.querySelector('.loading__spinner');
        const messageNode = form.querySelector('.lookbook-modal__form-message');
        const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');

        if (!submitButton) return;
        if (messageNode) messageNode.setAttribute('hidden', '');

        submitButton.setAttribute('aria-disabled', 'true');
        submitButton.classList.add('loading');
        if (spinner) spinner.classList.remove('hidden');

        const formData = new FormData(form);
        if (cart && typeof cart.getSectionsToRender === 'function') {
          const sectionIds = cart.getSectionsToRender().map((section) => section.id);
          formData.append('sections', sectionIds.join(','));
          formData.append('sections_url', window.location.pathname);
          if (typeof cart.setActiveElement === 'function') cart.setActiveElement(document.activeElement);
        }

        try {
          const config =
            typeof fetchConfig === 'function'
              ? fetchConfig('javascript')
              : {
                  method: 'POST',
                  headers: { Accept: 'application/javascript' },
                };
          config.method = 'POST';
          config.headers = config.headers || {};
          config.headers['X-Requested-With'] = 'XMLHttpRequest';
          delete config.headers['Content-Type'];
          config.body = formData;
          config.credentials = 'same-origin';

          const response = await fetch(window.routes.cart_add_url, config);
          const rawText = await response.text();
          let result;
          try {
            result = rawText ? JSON.parse(rawText) : {};
          } catch (parseErr) {
            console.error('Lookbook cart add: не JSON відповідь', parseErr, rawText.slice(0, 200));
            if (messageNode) {
              messageNode.textContent = 'Помилка відповіді сервера. Спробуйте ще раз.';
              messageNode.removeAttribute('hidden');
            }
            return;
          }

          if (result.status) {
            if (messageNode) {
              messageNode.textContent = result.description || result.message || 'Помилка при додаванні товару.';
              messageNode.removeAttribute('hidden');
            }
            return;
          }

          if (cart && typeof cart.renderContents === 'function' && result.sections) {
            try {
              cart.renderContents(result);
            } catch (renderErr) {
              console.error('Lookbook cart add: renderContents', renderErr);
              const cartResponse = await fetch(`${window.routes.cart_url}.js`, { credentials: 'same-origin' });
              const cartData = await cartResponse.json();
              updateCartCount(cartData.item_count || 0);
            }
          } else {
            const cartResponse = await fetch(`${window.routes.cart_url}.js`, { credentials: 'same-origin' });
            const cartData = await cartResponse.json();
            updateCartCount(cartData.item_count || 0);
          }
        } catch (error) {
          if (messageNode) {
            messageNode.textContent = 'Сталася помилка. Спробуйте ще раз.';
            messageNode.removeAttribute('hidden');
          }
          console.error(error);
        } finally {
          submitButton.classList.remove('loading');
          submitButton.removeAttribute('aria-disabled');
          if (spinner) spinner.classList.add('hidden');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Main block"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Right text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA button label",
      "default": "Shop the look"
    },
    {
      "type": "header",
      "content": "Modal"
    },
    {
      "type": "text",
      "id": "modal_heading",
      "label": "Modal heading",
      "default": "Shop the look"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Collection for 3 products"
    },
    {
      "type": "image_picker",
      "id": "modal_image",
      "label": "Right modal image"
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}